# ─── 分析服务环境变量 ───────────────────────────────────

# 此文件仅用于本地开发，禁止直接作为生产环境配置。
NODE_ENV=development

# 服务端口
ANALYSIS_PORT=8000

# Celery / Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# 主服务数据库（分析结果直写主库）
DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/home_rehab_motion

# OSS 对象存储
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET=home-rehab-motion-assets
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# MediaPipe 参数
SAMPLE_FPS=10
MODEL_COMPLEXITY=1

# 分析超时（秒）
ANALYSIS_TIMEOUT_SECONDS=600

# 回调通知地址
ANALYSIS_CALLBACK_URL=http://127.0.0.1:3000/api/videos/internal/analysis-callback
# 生产必须通过密钥管理服务注入，至少 32 位且不可使用默认值。
ANALYSIS_INTERNAL_TOKEN=

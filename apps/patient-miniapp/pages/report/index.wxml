<view class="rp-page">
  <view class="rp-top-sticky">
    <!-- 自定义状态栏 -->
    <view class="rp-statusbar" style="height: {{statusBarHeight}}px;"></view>

    <!-- 自定义导航栏 -->
    <view class="rp-nav">
      <view class="rp-nav__back" bindtap="onGoBack">
        <image class="rp-nav__back-icon" src="../../assets/icons/common/arrow-left.svg" mode="aspectFit"/>
      </view>
      <text class="rp-nav__title">本段动作报告</text>
      <view class="rp-nav__capsule"></view>
    </view>
  </view>

  <!-- 加载态 -->
  <view wx:if="{{loading}}" class="rp-loading">
    <view class="rp-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view>
    <image class="rp-loading__icon" src="../../assets/icons/common/loading.svg" mode="aspectFit" />
    <view class="rp-loading__text">正在生成报告...</view>
    <view class="rp-loading__sub">请稍候，系统正在整理本段动作的观察结果。</view>
  </view>

  <!-- 分析失败结果 -->
  <view wx:elif="{{isAnalysisFailed}}" class="rp-loading rp-failure-result">
    <view class="rp-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view>
    <view class="rp-failure-result__icon">!</view>
    <view class="rp-loading__text">{{failureTitle}}</view>
    <view class="rp-loading__sub">{{failureReason}}</view>
    <view class="rp-failure-result__tip">本次训练已计入训练日。视频分析是否成功不影响您的练习记录；如想再次拍摄，可在方便时尝试，不必勉强调整动作幅度。</view>
    <view class="rp-loading__actions">
      <button class="btn-big btn-teal" bindtap="onViewHistory">查看训练记录</button>
      <button class="btn-big btn-outline" bindtap="onRetryUpload">有需要时重新上传</button>
    </view>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadFailed}}" class="rp-loading rp-error-state">
    <view class="rp-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view>
    <view class="rp-error-state__card">
      <view class="rp-error-state__icon">{{errorIcon}}</view>
      <view class="rp-loading__text">{{errorTitle}}</view>
      <view class="rp-loading__sub">{{errorMessage}}</view>
      <view class="rp-loading__actions">
        <button class="btn-big btn-teal" bindtap="onRetryLoad">重新获取报告</button>
        <button wx:if="{{errorIcon === '⏳'}}" class="btn-big btn-outline" bindtap="onViewAnalyzing">继续等待分析</button>
        <button wx:else class="btn-big btn-outline" bindtap="onViewHistory">查看训练记录</button>
      </view>
    </view>
  </view>

  <!-- 主内容 -->
  <scroll-view wx:else class="rp-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="rp-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view>
    <view class="rp-scroll-inner">
      <view wx:if="{{showSafetyNotice}}" class="rp-safety-notice">
        <view class="rp-safety-notice__title">已记录本次身体不适</view>
        <view class="rp-safety-notice__desc">请先暂停训练。若不适持续、加重或影响活动，请及时联系主治医生或前往医疗机构评估。</view>
      </view>

      <view wx:if="{{requiresManualReview}}" class="rp-review-notice">
        <view class="rp-review-notice__badge">结果处理中</view>
        <view class="rp-review-notice__title">{{observedReps > 0 ? '已识别动作，评分待复核' : '本段动作结果待复核'}}</view>
        <view wx:if="{{observedReps > 0}}" class="rp-review-notice__count">系统识别动作 <text>{{observedReps}}</text> 次</view>
        <view class="rp-review-notice__desc">{{reviewMessage}}</view>
        <view wx:if="{{showSafetyNotice}}" class="rp-review-notice__tip">本次身体不适反馈已记录。复核完成前请先暂停训练，并以医生或医疗机构的建议为准。</view>
        <view wx:else class="rp-review-notice__tip">复核完成前，请先按动作指导练习；本次暂不展示分数和问题判断。</view>
      </view>

      <view wx:if="{{!requiresManualReview && isVisualPractice && !scoreAvailable}}" class="rp-review-notice">
        <view class="rp-review-notice__badge">暂不评分</view>
        <view class="rp-review-notice__title">本次训练已记录</view>
        <view class="rp-review-notice__desc">视频里暂时看不清完整动作。下次拍摄时，请把开始准备和最后放松的过程都拍进去。</view>
      </view>

      <!-- 同一报告骨架，指标名称由实际分析来源决定。 -->
      <view wx:if="{{!requiresManualReview && scoreAvailable}}" class="rp-hero">
        <view class="rp-hero__row">
          <view class="rp-score-circle">
            <text class="rp-score-circle__num">{{isVisualPractice && !showVisualScore ? '已' : averageScore}}</text>
            <text class="rp-score-circle__label">{{isVisualPractice && !showVisualScore ? '记录' : '本段评分'}}</text>
          </view>
          <view class="rp-hero__info">
            <text class="rp-hero__title">{{actionLabel}}</text>
            <text class="rp-hero__method">{{isVisualPractice ? '依据腹部起伏观察' : '依据身体姿态观察'}}<text wx:if="{{!isVisualPractice}}"> · {{grade}}</text></text>
          </view>
        </view>
      </view>

      <!-- 概要数据 2列 -->
      <view wx:if="{{!requiresManualReview && scoreAvailable}}" class="rp-stat-grid">
        <view class="rp-stat-card">
          <text class="rp-stat-card__value rp-stat-card__value--green">{{isVisualPractice ? practiceCountText : validRepsText}}</text>
          <text class="rp-stat-card__label">{{isVisualPractice ? '完整动作' : '本段有效次数'}}</text>
        </view>
        <view class="rp-stat-card">
          <text class="rp-stat-card__value rp-stat-card__value--teal">{{isVisualPractice ? cycleDurationText : holdDurationText}}</text>
          <text class="rp-stat-card__label">{{isVisualPractice ? '每次动作时长' : '平均保持'}}</text>
        </view>
      </view>

      <view wx:if="{{!requiresManualReview && isVisualPractice && scoreAvailable}}" class="info-panel rp-phase-panel">
        <view class="info-title">动作阶段（平均每次）</view>
        <view wx:if="{{visualPhaseMetricsAvailable}}" class="rp-phase-grid">
          <view class="rp-phase-cell"><text class="rp-phase-cell__label">逐渐隆起</text><text class="rp-phase-cell__value">{{riseTimeText}}</text></view>
          <view class="rp-phase-cell"><text class="rp-phase-cell__label">最高处保持</text><text class="rp-phase-cell__value">{{peakTimeText}}</text></view>
          <view class="rp-phase-cell"><text class="rp-phase-cell__label">放松回位</text><text class="rp-phase-cell__value">{{returnTimeText}}</text></view>
        </view>
        <view wx:if="{{!visualPhaseMetricsAvailable}}" class="rp-phase-unavailable">本段阶段时间暂不可用</view>
      </view>

      <!-- 动作评分摘要：仅展示当前动作具备独立计算依据的维度。 -->
      <view wx:if="{{!requiresManualReview && !isVisualPractice}}" class="info-panel">
        <view class="info-title">本段动作观察</view>
        <view class="rp-metric-list">
          <view class="rp-metric-line">
            <text class="rp-metric-key">准确性</text>
            <view class="rp-progress-bar"><view class="rp-progress-bar__fill" style="width: {{accuracyText}}%;"></view></view>
            <text class="rp-metric-val rp-metric-val--green">{{accuracyText}}</text>
          </view>
          <view class="rp-metric-line">
            <text class="rp-metric-key">稳定性</text>
            <view class="rp-progress-bar"><view class="rp-progress-bar__fill" style="width: {{stabilityText}}%;"></view></view>
            <text class="rp-metric-val rp-metric-val--teal">{{stabilityText}}</text>
          </view>
          <view wx:if="{{showControlMetric}}" class="rp-metric-line">
            <text class="rp-metric-key">控制力</text>
            <view class="rp-progress-bar"><view class="rp-progress-bar__fill rp-progress-bar__fill--orange" style="width: {{controlText}}%;"></view></view>
            <text class="rp-metric-val rp-metric-val--orange">{{controlText}}</text>
          </view>
          <view class="rp-metric-line">
            <text class="rp-metric-key">保持时间</text>
            <view class="rp-progress-bar"><view class="rp-progress-bar__fill rp-progress-bar__fill--orange" style="width: {{durationMetricText}}%;"></view></view>
            <text class="rp-metric-val rp-metric-val--orange">{{durationMetricText}}</text>
          </view>
        </view>
        <view wx:if="{{showSafetyNotice}}" class="rp-metric-summary">本段指标仅用于回顾视频中的动作。请先暂停训练，并以医生或医疗机构的建议为准。</view>
        <view wx:else class="rp-metric-summary">本段指标仅基于所上传的 1～2 个动作生成，不代表整套训练效果。</view>
      </view>

      <!-- 身体不适安全态不展示训练重点和动作建议，避免与“暂停训练”冲突。 -->
      <view wx:if="{{!requiresManualReview && !showSafetyNotice}}" class="info-panel rp-next-step-panel">
        <view class="rp-next-step-panel__eyebrow">本段动作提示</view>
        <view class="info-title">{{reportFocusTitle}}</view>
        <view class="rp-next-step-panel__summary">{{reportFocusText}}</view>
        <view wx:if="{{adviceSummary.length}}" class="rp-advice-list">
          <block wx:for="{{adviceSummary}}" wx:key="adviceCode">
            <view class="rp-advice-item"><text class="rp-advice-item__dot"></text><text>{{item.patientText}}</text></view>
          </block>
        </view>
      </view>

      <!-- 原始训练视频按需展开：不自动播放，避免干扰报告阅读与暴露敏感内容 -->
      <view wx:if="{{videoReview}}" class="rp-video-review">
        <view class="rp-video-review__header" bindtap="onToggleVideo">
          <view>
            <view class="rp-video-review__title">查看本次视频</view>
            <view class="rp-video-review__hint">仅本人可看</view>
          </view>
          <text class="rp-video-review__toggle">{{videoExpanded ? '收起' : '查看回放'}}</text>
        </view>
        <video wx:if="{{videoExpanded && !videoLoadFailed}}" class="rp-video-review__player" src="{{videoReview.playbackUrl}}" controls show-center-play-btn show-fullscreen-btn enable-progress-gesture object-fit="contain" binderror="onVideoError"></video>
        <view wx:if="{{videoLoadFailed}}" class="rp-video-review__error">视频暂时无法播放，请稍后从训练记录中查看。</view>
      </view>

      <!-- 保留训练日徽章，但不展示旧接口返回的整套训练进步结论。 -->
      <view wx:if="{{!requiresManualReview && !showSafetyNotice && newlyUnlockedBadges.length}}" class="rp-motivation-panel">
        <view wx:for="{{newlyUnlockedBadges}}" wx:key="badgeCode" class="rp-motivation-panel__badge">🏅 解锁「{{item.title}}」</view>
      </view>

      <!-- 反馈入口 -->
      <view class="rp-feedback-panel rp-feedback-panel--compact">
        <view class="rp-feedback-panel__title">有疑问？</view>
        <button class="btn-big rp-feedback-panel__btn" bindtap="onToggleFeedback">{{feedbackEntryLabel}}</button>
      </view>

      <!-- 次级操作：避免和底部主操作竞争 -->
      <view class="rp-page-footer">
        <button class="btn-big btn-ghost" bindtap="onViewHistory">查看训练记录</button>
      </view>

      <!-- 底部操作栏占位 -->
      <view class="dock-spacer"></view>
    </view>
  </scroll-view>

  <!-- 底部固定操作栏：身体不适时不引导继续训练 -->
  <view class="action-dock">
    <button wx:if="{{showSafetyNotice}}" class="btn-big btn-teal" bindtap="onViewHistory">查看训练记录</button>
    <button wx:else class="btn-big btn-teal" bindtap="onBackHome">再练一次</button>
  </view>
</view>

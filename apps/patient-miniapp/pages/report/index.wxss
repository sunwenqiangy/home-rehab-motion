@import '../../app.wxss';

/* ========== 待复核提示 ========== */
.rp-review-notice {
  padding: 30rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fffaf0 0%, #fff5df 100%);
  border: 1rpx solid #f3d49b;
  box-shadow: 0 12rpx 28rpx rgba(174, 117, 27, 0.08);
  color: #734d12;
}

.rp-review-notice__badge {
  display: inline-flex;
  min-height: 40rpx;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(197, 126, 26, 0.12);
  color: #9c6414;
  font-size: 22rpx;
  font-weight: 700;
}

.rp-review-notice__title {
  margin-top: 14rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.rp-review-notice__desc,
.rp-review-notice__tip {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.rp-review-notice__tip {
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(183, 122, 29, 0.16);
  color: #8a661f;
}

/* ========== 激励反馈 ========== */
.rp-motivation-panel {
  margin: 24rpx 0;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #eefaf5;
  border: 1rpx solid #c8eadb;
  color: #246b50;
}

.rp-motivation-panel__message {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.6;
}

.rp-motivation-panel__badge {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #a45e16;
}

/* ========== 页面基础 ========== */
page {
  background: #f7fafc;
}

.rp-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7fafc;
}

/* ========== 自定义状态栏 ========== */
.rp-top-sticky {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
}

.rp-statusbar {
  background: #ffffff;
  flex-shrink: 0;
}

/* ========== 自定义导航栏 ========== */
.rp-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx 20rpx;
  background: #ffffff;
  box-sizing: border-box;
  gap: 12rpx;
}

.rp-nav__back {
  width: 64rpx;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.rp-nav__back-icon {
  font-size: 48rpx;
  font-weight: 300;
  color: #2d3748;
  line-height: 1;
}

.rp-nav__title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 800;
  color: #1a202c;
  text-align: left;
}

.rp-nav__capsule {
  width: 152rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: none;
  background: transparent;
  box-shadow: none;
  flex-shrink: 0;
}

/* ========== 加载态 ========== */
.rp-loading {
  padding: 64rpx 32rpx;
  text-align: center;
}

.rp-loading__text {
  font-size: 32rpx;
  font-weight: 700;
  color: #17314f;
}

.rp-loading__sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #7b91a8;
  line-height: 1.7;
}

.rp-loading__actions {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rp-failure-result {
  min-height: 100vh;
  box-sizing: border-box;
}

.rp-failure-result__icon {
  width: 88rpx;
  height: 88rpx;
  margin: 72rpx auto 24rpx;
  border-radius: 50%;
  background: #fff0ef;
  color: #e05a52;
  text-align: center;
  line-height: 88rpx;
  font-size: 52rpx;
  font-weight: 800;
}

.rp-failure-result__tip {
  margin-top: 24rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #fff9ed;
  color: #8a6732;
  font-size: 25rpx;
  line-height: 1.7;
  text-align: left;
}

.rp-safety-notice {
  padding: 22rpx 24rpx;
  border: 1rpx solid #f4d2ad;
  border-radius: 24rpx;
  background: #fff9ef;
}

.rp-safety-notice__title {
  color: #bf6a2c;
  font-size: 28rpx;
  font-weight: 800;
}

.rp-safety-notice__desc {
  margin-top: 8rpx;
  color: #8a6732;
  font-size: 24rpx;
  line-height: 1.7;
}

/* ========== 可滚动主区域 ========== */
.rp-scroll {
  flex: 1;
  min-height: 0;
}

.rp-top-placeholder {
  width: 100%;
  flex-shrink: 0;
}

.rp-scroll-inner {
  padding: 24rpx 28rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* ========== 评级 Hero ========== */
.rp-hero {
  padding: 36rpx 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(145deg, #48bb78 0%, #38a169 50%, #2f855a 100%);
  box-shadow: 0 20rpx 48rpx rgba(47, 133, 90, 0.2);
  border: 1rpx solid rgba(72, 187, 120, 0.3);
}

.rp-hero__row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.rp-score-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rp-score-circle__num {
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
}

.rp-score-circle__label {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.85);
}

.rp-hero__info {
  flex: 1;
  min-width: 0;
}

.rp-hero__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
}

.rp-hero__compare {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.rp-hero__chips {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.rp-hero__chip {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

/* ========== 概要数据 2列 ========== */
.rp-stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.rp-stat-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(121, 175, 219, 0.16);
  box-shadow: 0 14rpx 34rpx rgba(34, 87, 139, 0.08);
  text-align: center;
}

.rp-stat-card__value {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.rp-stat-card__value--green {
  color: #38a169;
}

.rp-stat-card__value--teal {
  color: #38b2ac;
}

.rp-stat-card__label {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #718096;
}

/* ========== info-panel 通用面板 ========== */
.info-panel {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(34, 87, 139, 0.08);
  border: 1rpx solid rgba(121, 175, 219, 0.16);
}

.info-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
  margin-bottom: 20rpx;
}

/* ========== 四维评分 ========== */
.rp-metric-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rp-metric-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rp-metric-key {
  width: 120rpx;
  font-size: 26rpx;
  color: #4a5568;
  flex-shrink: 0;
}

.rp-progress-bar {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(22, 111, 247, 0.08);
  overflow: hidden;
}

.rp-progress-bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #48bb78 0%, #38a169 100%);
}

.rp-progress-bar__fill--orange {
  background: linear-gradient(90deg, #ed8936 0%, #dd6b20 100%);
}

.rp-metric-val {
  width: 60rpx;
  text-align: right;
  font-size: 26rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.rp-metric-val--green {
  color: #38a169;
}

.rp-metric-val--teal {
  color: #38b2ac;
}

.rp-metric-val--orange {
  color: #dd6b20;
}

.rp-metric-summary {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

.rp-metric-summary__strong {
  color: #dd6b20;
  font-weight: 700;
}

/* ========== 阶段重点(绿色左边框) ========== */
.rp-stage-focus {
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 20rpx 48rpx rgba(34, 87, 139, 0.1);
  border: 1rpx solid rgba(121, 175, 219, 0.18);
  border-left: 8rpx solid #48bb78;
}

.rp-stage-focus__title {
  font-size: 32rpx;
  font-weight: 800;
  color: #38a169;
}

.rp-stage-focus__body {
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.rp-stage-focus__line {
  font-size: 28rpx;
  line-height: 1.8;
  color: #4a5568;
}

/* ========== stage-grid 阶段卡片 ========== */
.stage-grid {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.stage-card {
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(121, 175, 219, 0.18);
}

.stage-card--waiting {
  background: rgba(247, 250, 252, 0.9);
  border-color: rgba(121, 175, 219, 0.18);
}

.stage-card--active {
  background: rgba(227, 252, 236, 0.9);
  border-color: rgba(53, 173, 116, 0.32);
}

.stage-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a202c;
}

.stage-card--active .stage-name {
  color: #22543d;
}

.stage-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.66;
  color: #5f7892;
}

/* ========== 系统建议 ========== */
.rp-next-step-panel {
  border-color: rgba(53, 173, 116, 0.24);
  background: linear-gradient(145deg, #ffffff 0%, #f3fbf6 100%);
}

.rp-next-step-panel__eyebrow {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #299665;
}

.rp-next-step-panel .info-title {
  margin-bottom: 18rpx;
  color: #22543d;
}

.rp-advice-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.rp-advice-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  font-size: 27rpx;
  line-height: 1.7;
  color: #3f5d52;
}

.rp-advice-item__dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: #38a169;
  box-shadow: 0 0 0 6rpx rgba(56, 161, 105, 0.12);
}

/* ========== 反馈入口(蓝色面板) ========== */
.rp-feedback-panel {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #f4f8ff;
  border: 1rpx solid rgba(49, 130, 206, 0.18);
}

.rp-feedback-panel__title {
  font-size: 32rpx;
  font-weight: 800;
  color: #3182ce;
}

.rp-feedback-panel__desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #4a5568;
}

.rp-feedback-panel__btn {
  margin-top: 20rpx;
  background: #3182ce;
  color: #ffffff;
  border: none;
  border-radius: 18rpx;
  min-height: 80rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: none;
}

.rp-feedback-panel__btn::after {
  border: none;
}

/* ========== 反馈表单 ========== */
.rp-feedback-picker {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(22, 111, 247, 0.06);
  color: #35516f;
  font-size: 28rpx;
}

.rp-feedback-input {
  width: 100%;
  min-height: 220rpx;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #f7fbff;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #35516f;
}

.rp-feedback-image-row {
  margin-top: 18rpx;
}

.rp-feedback-image-btn {
  min-width: 200rpx;
}

.rp-feedback-image-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.rp-feedback-image-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(117, 162, 204, 0.2);
  background: rgba(248, 251, 255, 0.9);
}

.rp-feedback-image-item__img {
  width: 140rpx;
  height: 140rpx;
}

.rp-feedback-image-item__remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 页尾 ========== */
.rp-page-footer {
  padding: 2rpx 0 10rpx;
}

.rp-page-footer .btn-big {
  margin-top: 0;
  min-height: 80rpx;
  font-size: 28rpx;
}

/* ========== 底部操作栏占位 ========== */
.dock-spacer {
  height: 200rpx;
}

/* ========== 底部固定操作栏 ========== */
.action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -6rpx 24rpx rgba(34, 87, 139, 0.08);
  border-top: 1rpx solid rgba(121, 175, 219, 0.14);
  backdrop-filter: blur(20rpx);
  z-index: 100;
}

.action-dock .btn-big {
  display: flex !important;
  width: 100% !important;
  min-width: 100% !important;
  margin: 0 !important;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
}

/* ========== 按钮样式 ========== */
.btn-big {
  width: 100%;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: none;
  line-height: 1;
  margin-top: 16rpx;
}

.btn-big::after {
  border: none;
}

.btn-teal {
  background: linear-gradient(135deg, #38b2ac 0%, #2c7a7b 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(44, 122, 123, 0.28);
}

.btn-outline {
  background: rgba(255, 255, 255, 0.9);
  color: #4a5568;
  border: 2rpx solid rgba(121, 175, 219, 0.24);
  box-shadow: 0 8rpx 20rpx rgba(34, 87, 139, 0.06);
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.9);
  color: #4a5568;
  border: 2rpx solid rgba(121, 175, 219, 0.24);
  box-shadow: 0 8rpx 20rpx rgba(34, 87, 139, 0.06);
}

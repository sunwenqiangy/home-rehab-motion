.profile-page {
  min-height: 100vh;
  background: #f7fafc;
  color: #1a202c;
}

.profile-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 92rpx;
  padding-right: 28rpx;
  padding-left: 28rpx;
  border-bottom: 1rpx solid #edf2f7;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 4rpx 18rpx rgba(26, 32, 44, 0.04);
  box-sizing: content-box;
}

.profile-back,
.profile-nav__placeholder {
  width: 72rpx;
  height: 72rpx;
}

.profile-back {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #0e9aa7;
  font-size: 64rpx;
  line-height: 1;
}

.profile-nav__title {
  font-size: 34rpx;
  font-weight: 800;
}

.profile-content {
  padding-right: 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  padding-left: 32rpx;
}

.profile-hero {
  margin-top: 24rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #0e9aa7, #3ec6d0);
  color: #fff;
  box-shadow: 0 14rpx 30rpx rgba(14, 154, 167, 0.18);
  margin-bottom: 24rpx;
}

.profile-hero__icon {
  font-size: 60rpx;
}

.profile-hero__title {
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.profile-hero__desc,
.profile-card__desc,
.profile-privacy {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
}

.profile-hero__desc {
  opacity: 0.88;
}

.profile-card {
  margin-top: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #edf2f7;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 4rpx 24rpx rgba(14, 154, 167, 0.06);
}

.profile-card--phone {
  margin-bottom: 4rpx;
}

.profile-card__title {
  font-size: 32rpx;
  font-weight: 800;
}

.profile-avatar-row {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  gap: 20rpx;
}

.profile-avatar {
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex: 0 0 104rpx;
  border: 2rpx solid rgba(70, 168, 224, .16);
  border-radius: 28rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: .02em;
  box-shadow: 0 8rpx 18rpx rgba(38, 139, 190, .16);
  text-shadow: 0 2rpx 4rpx rgba(0, 72, 100, .14);
}

.profile-avatar--male { background: linear-gradient(145deg, #65c9ee 0%, #3e9ed4 100%); }
.profile-avatar--female { background: linear-gradient(145deg, #ef9ac0 0%, #ce6d9d 100%); }
.profile-avatar--unknown { background: linear-gradient(145deg, #78c0c5 0%, #459aa5 100%); }

.profile-avatar-copy {
  flex: 1;
  min-width: 0;
}

.profile-avatar-copy__hint {
  margin-top: 8rpx;
  color: #718096;
  font-size: 24rpx;
  line-height: 1.45;
}

.profile-card__desc,
.profile-privacy {
  color: #718096;
}

.profile-input {
  height: 88rpx;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 30rpx;
}

.profile-field-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid #edf2f7;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 30rpx;
}

.profile-field-label {
  width: 120rpx;
  color: #4a5568;
}

.profile-field-input,
.profile-field-value {
  flex: 1;
  min-width: 0;
  color: #1a202c;
}

/* 展示层和 picker 点击层分离；Flex 避免安卓端绝对定位文本出现垂直偏移。 */
.profile-gender-control {
  position: relative;
  display: flex;
  height: 86rpx;
  min-width: 0;
  flex: 1;
  align-items: stretch;
}

.profile-gender-display {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
}

.profile-gender-value {
  min-width: 0;
  color: #1a202c;
  line-height: 44rpx;
  text-align: right;
}

.profile-gender-display .profile-field-arrow {
  display: block;
  width: 24rpx;
  height: 24rpx;
  margin-left: 18rpx;
  opacity: .42;
}

.profile-gender-picker {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  opacity: 0;
}

.profile-gender-picker__hit-area {
  width: 100%;
  height: 86rpx;
}

.profile-field-unit {
  color: #718096;
}

.profile-nickname-actions {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 20rpx;
}

.profile-wechat-name,
.profile-nickname-save,
.profile-save,
.profile-phone-button {
  border: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

/* 覆盖小程序 button 默认伪边框，避免操作区出现细线和高度不一致。 */
.profile-wechat-name::after,
.profile-nickname-save::after,
.profile-save::after,
.profile-phone-button::after {
  border: 0;
}

.profile-nickname-actions .profile-wechat-name,
.profile-nickname-actions .profile-nickname-save {
  display: flex;
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 0 12rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 1.2;
  white-space: nowrap;
}

.profile-wechat-name {
  color: #087f8b;
  background: #e6f7f8;
}

.profile-nickname-save {
  color: #fff;
  background: #0e9aa7;
}

.profile-card__hint {
  margin-top: 14rpx;
  color: #718096;
  font-size: 24rpx;
  line-height: 1.55;
}

.profile-save,
.profile-phone-button {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  margin-top: 24rpx;
  margin-right: 0;
  margin-left: 0;
  padding: 0 32rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  color: #fff;
  background: #0e9aa7;
  line-height: 1.2;
  white-space: nowrap;
}

.profile-phone-status {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  color: #2f855a;
  background: #f0fff4;
  font-size: 28rpx;
}

.profile-privacy {
  padding: 28rpx 12rpx 0;
  font-size: 24rpx;
}

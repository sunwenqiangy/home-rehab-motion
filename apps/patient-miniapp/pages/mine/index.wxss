/* ========== P08 我的 — V4 高保真 ========== */

.v4-page {
  min-height: 100vh;
  background: #f7fafc;
  display: flex;
  flex-direction: column;
}

.v4-top-sticky {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
}

.v4-statusbar {
  background: #fff;
  flex-shrink: 0;
}

.v4-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 16rpx 24rpx 20rpx 36rpx;
  background: #fff;
  box-sizing: border-box;
  gap: 12rpx;
}
.v4-navbar-title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 800;
  color: #1a202c;
  text-align: left;
}
.v4-navbar-capsule {
  width: 152rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: none;
  background: transparent;
  box-shadow: none;
  flex-shrink: 0;
}

.v4-screen {
  flex: 1;
  padding: 16rpx 32rpx 200rpx;
  background: #f7fafc;
}

.v4-top-placeholder {
  width: 100%;
  flex-shrink: 0;
}

/* Hero 卡片 - teal 渐变 */
.v4-hero-card {
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.v4-guest-hero {
  padding: 34rpx 36rpx 30rpx;
  background: linear-gradient(135deg, #087f89 0%, #39bfc7 100%);
}

.v4-guest-hero__eyebrow {
  margin-bottom: 26rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.v4-hero-teal {
  background: linear-gradient(135deg, #0e9aa7 0%, #3ec6d0 100%);
  color: #fff;
}

/* 个人信息行 */
.v4-profile-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}
.v4-profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  flex-shrink: 0;
}
.v4-profile-info {
  flex: 1;
  min-width: 0;
}

.v4-profile-skeleton {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.v4-skeleton-line,
.v4-skeleton-block {
  background: rgba(255, 255, 255, 0.32);
  border-radius: 999rpx;
  animation: v4-skeleton-pulse 1.2s ease-in-out infinite;
}

.v4-skeleton-line--name { width: 180rpx; height: 34rpx; }
.v4-skeleton-line--sub { width: 250rpx; height: 24rpx; }
.v4-skeleton-block { background: #edf2f7; }
.v4-skeleton-block--stat { width: 62rpx; height: 48rpx; margin: 0 auto; }
.v4-skeleton-block--chip { width: 110rpx; height: 40rpx; }

@keyframes v4-skeleton-pulse {
  50% { opacity: 0.45; }
}

.v4-hero-login-button {
  width: 100%;
  height: 76rpx;
  margin: 30rpx 0 0;
  padding: 0;
  border: 0;
  border-radius: 20rpx;
  color: #087f89;
  background: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 76rpx;
  box-shadow: 0 8rpx 20rpx rgba(2, 74, 80, 0.16);
}

.v4-hero-login-button::after {
  border: none;
}

.v4-guest-tip {
  margin-bottom: 24rpx;
  padding: 26rpx 30rpx;
  border: 2rpx solid #d3ecea;
  border-radius: 28rpx;
  background: #ffffff;
}

.v4-guest-tip__title {
  color: #1a202c;
  font-size: 30rpx;
  font-weight: 800;
}

.v4-guest-tip__desc {
  margin-top: 10rpx;
  color: #718096;
  font-size: 26rpx;
  line-height: 1.6;
}
.v4-profile-name {
  font-size: 40rpx;
  font-weight: 800;
}
.v4-profile-sub {
  font-size: 28rpx;
  opacity: 0.85;
  margin-top: 8rpx;
  line-height: 1.45;
}

/* 统计概览 3列 */
.v4-stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.v4-stats-grid--3 {
  grid-template-columns: 1fr 1fr 1fr;
}
.v4-stats-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(14,154,167,0.08);
}
.v4-stats-value {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.1;
}
.v4-stats-value--teal { color: #0e9aa7; }
.v4-stats-value--green { color: #38a169; }
.v4-stats-value--orange { color: #dd6b20; }
.v4-stats-label {
  font-size: 24rpx;
  color: #718096;
  margin-top: 8rpx;
}

/* 信息面板 */
.v4-info-panel {
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(14,154,167,0.08);
  margin-bottom: 24rpx;
}
.v4-info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.v4-info-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
}

/* Chip */
.v4-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}
.v4-chip--teal { background: #e6f7f8; color: #0e9aa7; }
.v4-chip--gray { background: #edf2f7; color: #718096; }
.v4-chip--sm { padding: 8rpx 24rpx; font-size: 24rpx; }

/* 徽章快速入口 */
.v4-badge-loading {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  color: #718096;
  background: #f8fafc;
  font-size: 26rpx;
  text-align: center;
}

.v4-badge-quick {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-top: 24rpx;
}
.v4-badge-item {
  text-align: center;
}
.v4-badge-bubble {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 0 auto 12rpx;
}
.v4-badge-bubble--teal { background: #e6f7f8; color: #0e9aa7; }
.v4-badge-bubble--orange { background: #fffaf0; color: #dd6b20; }
.v4-badge-bubble--green { background: #f0fff4; color: #38a169; }
.v4-badge-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2d3748;
}

/* 查看全部徽章链接 */
.v4-badge-all-link {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin-top: 24rpx;
  text-align: center;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(14,154,167,0.4);
  color: #0e9aa7;
  font-size: 28rpx;
  font-weight: 700;
  background: rgba(14,154,167,0.04);
}

/* 卡片 */
.v4-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(14,154,167,0.08);
  margin-bottom: 24rpx;
}

/* 菜单列表行 */
.v4-list-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}
.v4-list-row:last-child {
  border-bottom: none;
}

/* 列表图标 */
.v4-list-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 28rpx;
  flex-shrink: 0;
}
.v4-list-icon--blue { background: #ebf8ff; }
.v4-list-icon--teal { background: #e6f7f8; }
.v4-list-icon--green { background: #f0fff4; }
.v4-list-icon--orange { background: #fffaf0; }

/* 列表主体 */
.v4-list-body {
  flex: 1;
  min-width: 0;
}
.v4-list-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a202c;
}
.v4-list-sub {
  font-size: 26rpx;
  color: #718096;
  margin-top: 4rpx;
}

/* 通知小圆点 */
.v4-notice-dot {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: #f56565;
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  padding: 0 10rpx;
  margin-right: 12rpx;
}

/* 列表箭头 */
.v4-list-arrow {
  font-size: 36rpx;
  color: #cbd5e0;
  margin-left: 16rpx;
}

/* 退出登录 */
.v4-logout-wrap {
  text-align: center;
  padding: 40rpx 0;
}
.v4-logout-btn {
  background: none;
  border: none;
  color: #cbd5e0;
  font-size: 30rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.v4-preview-session-hint {
  margin: 0 auto 16rpx;
  color: #8a5a16;
  font-size: 25rpx;
  text-align: center;
}

/* TabBar */
.v4-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
  padding: 12rpx 0 calc(env(safe-area-inset-bottom) + 4rpx);
  z-index: 10;
}
.v4-tab-item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  justify-content: center;
  min-height: 82rpx;
  font-size: 22rpx;
  color: #718096;
}
.v4-tab-item--active {
  color: #087f8b;
  font-weight: 800;
}
.v4-tab-item--active::after {
  position: absolute;
  top: -2rpx;
  width: 56rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #0e9aa7;
  content: '';
}
.v4-tab-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  font-size: 40rpx;
  line-height: 1;
}
.v4-tab-item--active .v4-tab-icon {
  border-radius: 16rpx;
  background: #e6f7f8;
  transform: translateY(-2rpx) scale(1.08);
}
.v4-tab-label {
  font-size: 22rpx;
  line-height: 1.2;
}

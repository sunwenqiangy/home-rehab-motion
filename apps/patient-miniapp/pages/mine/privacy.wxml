<view class="container privacy-page privacy-page--{{displayMode}}">
  <view class="hero-card privacy-hero card-pad-md">
    <view class="hero-eyebrow-row">
      <text class="hero-badge">🔒 隐私政策</text>
    </view>
    <view class="privacy-hero__title">您的训练数据，仅用于康复训练服务</view>
    <view class="privacy-hero__desc">这里说明训练数据如何使用，以及视频分析授权状态。</view>
    <view class="hero-chip-list">
      <text class="hero-chip" wx:for="{{summaryTags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="surface-card privacy-summary card-pad-md">
    <view class="privacy-summary__title">先看摘要</view>
    <view class="privacy-summary__desc">视频分析授权会随登录建立，上传视频前会使用该授权。</view>
    <view class="privacy-summary__desc">当前状态：{{consentStatusText}}</view>
  </view>

  <view class="privacy-page__content">
    <view class="surface-card privacy-section card-pad-md" wx:for="{{sections}}" wx:key="title">
      <view class="privacy-section__title">{{item.title}}</view>
      <view class="privacy-section__content">{{item.content}}</view>
    </view>

    <view class="surface-card privacy-summary card-pad-md">
      <view class="privacy-summary__title">视频分析授权</view>
      <view class="privacy-summary__desc">上传并分析训练视频会使用视频分析授权。</view>
      <button wx:if="{{consentStatusLoaded && !consented}}" class="privacy-consent-btn" bindtap="onGrantConsent">同意并开启视频分析</button>
    </view>

    <view class="surface-card privacy-notice card-pad-md">
      <view class="privacy-section__title">⚠️ 安全提醒</view>
      <view class="privacy-section__content">如您在训练中感到身体不适，请立即停止并联系主治医生。本系统仅提供训练评估建议，不构成医学诊断。</view>
    </view>
  </view>
</view>

<view class="container videos-page videos-page--{{displayMode}}">
  <view class="hero-card videos-hero card-pad-md">
    <view class="hero-eyebrow-row">
      <text class="hero-badge">📹 我的视频</text>
      <text class="hero-time-pill">{{totalCountText}}</text>
    </view>
    <view class="videos-hero__title">训练记录一览</view>
    <view class="videos-hero__desc">可直接查看视频分析进度、报告结果和重传入口。</view>

    <view class="summary-grid videos-summary-grid">
      <view class="summary-card history-summary-card history-summary-card--success">
        <view class="summary-label">已完成</view>
        <view class="summary-value">{{completedCount}}</view>
        <view class="summary-foot">可查看训练报告</view>
      </view>
      <view class="summary-card history-summary-card history-summary-card--warn">
        <view class="summary-label">分析中</view>
        <view class="summary-value">{{processingCount}}</view>
        <view class="summary-foot">稍后可回看</view>
      </view>
    </view>

    <view class="videos-hero__sub-line" wx:if="{{failedCount > 0}}">当前有 {{failedCount}} 条记录需要重传</view>
  </view>

  <view wx:if="{{loading}}" class="state-card loading-card">
    <view class="section-title">正在加载视频列表...</view>
  </view>

  <view wx:elif="{{!items.length}}" class="state-card loading-card empty-state-card">
    <view class="empty-state-card__badge">还没有训练视频</view>
    <view class="section-title">上传一次训练视频后，这里会出现记录</view>
    <view class="section-desc">您可以从首页开始训练，提交视频分析后，再回来查看状态。</view>
  </view>

  <view wx:else class="videos-page__content">
    <block wx:for="{{items}}" wx:key="videoId">
      <view class="panel-card videos-record list-card" data-video-id="{{item.videoId}}" data-status="{{item.status}}" data-action-type="{{item.actionType}}" bindtap="onViewDetail">
        <view class="videos-record__marker {{item.status === 'completed' ? 'videos-record__marker--success' : item.status === 'processing' || item.status === 'queued' || item.status === 'pending' || item.status === 'uploading' ? 'videos-record__marker--warn' : 'videos-record__marker--danger'}}"></view>
        <view class="videos-record__main">
          <view class="videos-record__head">
            <view class="videos-record__title">{{item.actionLabel}}</view>
            <text class="videos-record__status videos-record__status--{{item.statusClassName}}">{{item.statusLabel}}</text>
          </view>
          <view class="videos-record__meta">上传时间 {{item.uploadedAtLabel}}</view>
          <view class="videos-record__detail">{{item.detailText}}</view>
          <view class="videos-record__progress-bar">
            <view class="videos-record__progress-fill {{item.status === 'completed' ? 'videos-record__progress-fill--success' : item.status === 'processing' || item.status === 'queued' || item.status === 'pending' || item.status === 'uploading' ? 'videos-record__progress-fill--active' : 'videos-record__progress-fill--danger'}}" style="width: {{item.progressPercent}}%"></view>
          </view>
        </view>
        <view class="videos-record__side">
          <text class="videos-record__result">{{item.resultText}}</text>
          <text class="videos-record__action">{{item.actionText}}</text>
        </view>
      </view>
    </block>
  </view>
</view>

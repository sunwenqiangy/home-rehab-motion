@import '../../app.wxss';

.about-page--elderly {
  font-size: 34rpx;
}

.about-page--standard {
  font-size: 28rpx;
}

.about-page__content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.about-hero__title {
  margin-top: 18rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #173f3b;
}

.about-hero__desc {
  margin-top: 16rpx;
  font-size: 27rpx;
  line-height: 1.85;
  color: #66817c;
}

.about-section__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #173f3b;
}

.about-feature {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 22rpx;
}

.about-feature__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #e8f6f3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.about-feature__main {
  flex: 1;
  min-width: 0;
}

.about-feature__name {
  font-size: 28rpx;
  font-weight: 700;
  color: #173f3b;
}

.about-feature__desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #66817c;
}

.about-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(121, 175, 219, 0.1);
}

.about-info-row:last-child {
  border-bottom: none;
}

.about-info-row__label {
  font-size: 26rpx;
  color: #78938d;
}

.about-info-row__value {
  font-size: 26rpx;
  font-weight: 700;
  color: #173f3b;
}

.about-notice {
  background: rgba(245, 101, 101, 0.04);
  border: 1rpx solid rgba(245, 101, 101, 0.12);
}

.about-notice .about-section__title {
  color: #e53e3e;
}

.about-notice__content {
  margin-top: 14rpx;
  font-size: 27rpx;
  line-height: 1.85;
  color: #52766f;
}

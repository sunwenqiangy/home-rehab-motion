/* ========== P11 全部徽章 — V4 高保真 ========== */

.v4-page {
  min-height: 100vh;
  background: #f7fafc;
  display: flex;
  flex-direction: column;
}

/* 状态栏 */
.v4-top-sticky {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
}

.v4-statusbar {
  background: #fff;
  flex-shrink: 0;
}

/* 导航栏 */
.v4-navbar {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 16rpx 24rpx 20rpx 20rpx;
  background: #fff;
  box-sizing: border-box;
  gap: 12rpx;
}
.v4-navbar-left {
  width: 64rpx;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.v4-navbar-back {
  font-size: 48rpx;
  color: #2d3748;
  font-weight: 300;
  line-height: 1;
}
.v4-navbar-title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 800;
  color: #1a202c;
  text-align: left;
}
.v4-navbar-capsule {
  width: 152rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: none;
  background: transparent;
  box-shadow: none;
  flex-shrink: 0;
}

/* 内容区 */
.v4-screen {
  flex: 1;
  padding: 0 32rpx 80rpx;
  background: #f7fafc;
}

.v4-top-placeholder {
  width: 100%;
  flex-shrink: 0;
}

/* 徽章统计头部 */
.v4-badge-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0 16rpx;
}
.v4-badge-header__title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a202c;
}

/* 进度条 */
.v4-progress-bar {
  height: 20rpx;
  background: #edf2f7;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}
.v4-progress-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #0e9aa7, #3ec6d0);
  transition: width 0.6s;
}

/* Chip */
.v4-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.v4-chip--teal { background: #e6f7f8; color: #0e9aa7; }
.v4-chip--gray { background: #edf2f7; color: #718096; }
.v4-chip--orange { background: #fffaf0; color: #dd6b20; }
.v4-chip--green { background: #f0fff4; color: #38a169; }
.v4-chip--coral { background: #fff1f0; color: #f56565; }
.v4-chip--sm { padding: 4rpx 16rpx; font-size: 22rpx; }

/* 筛选 Chips */
.v4-filter-chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 8rpx 0 24rpx;
}

/* 信息面板 */
.v4-panel {
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 24rpx rgba(14, 154, 167, 0.08);
  margin-bottom: 24rpx;
}
.v4-panel-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
  margin-bottom: 20rpx;
}
.v4-panel-title--green {
  color: #38a169;
}
.v4-panel-title--muted {
  color: #718096;
}
/* 徽章网格 */
.v4-badge-grid {
  display: flex;
  gap: 32rpx;
  flex-wrap: wrap;
  justify-content: center;
}

/* 徽章项 */
.v4-badge-item {
  text-align: center;
  width: 160rpx;
}

/* 已获得徽章气泡 */
.v4-badge-bubble {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin: 0 auto 12rpx;
}
.v4-badge-bubble--teal {
  background: #e6f7f8;
  color: #0e9aa7;
}
.v4-badge-bubble--orange {
  background: #fffaf0;
  color: #dd6b20;
}
.v4-badge-bubble--green {
  background: #f0fff4;
  color: #38a169;
}

/* 未解锁徽章气泡 */
.v4-badge-bubble--locked {
  background: #edf2f7;
  color: #cbd5e0;
  filter: grayscale(1);
}

/* 徽章名称 */
.v4-badge-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #2d3748;
  line-height: 1.4;
}
.v4-badge-name--locked {
  color: #cbd5e0;
}

/* 徽章描述 */
.v4-badge-hint {
  font-size: 20rpx;
  color: #718096;
  margin-top: 4rpx;
  line-height: 1.5;
}
.v4-badge-hint--locked {
  color: #cbd5e0;
}

/* 已锁定状态整体降低透明度 */
.v4-badge-item--locked {
opacity: 0.45;
}

.v4-badge-item--highlighted {
  padding: 10rpx 4rpx;
  border-radius: 18rpx;
  background: #fff7df;
  box-shadow: 0 0 0 3rpx #f2bf50;
}

/* 空态 */
.v4-empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}
.v4-empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.v4-empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2d3748;
}
.v4-empty-desc {
  font-size: 28rpx;
  color: #718096;
  margin-top: 12rpx;
  line-height: 1.6;
}
.v4-empty-action {
  display: inline-flex;
  min-height: 64rpx;
  margin-top: 28rpx;
  padding: 0 36rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  color: #087f8b;
  background: #e6f7f8;
  font-size: 26rpx;
  font-weight: 800;
}
.v4-empty-action:active { opacity: .72; transform: scale(.98); }

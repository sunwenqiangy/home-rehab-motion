@import '../../app.wxss';

/* ========== 页面基础 ========== */
page {
  background: #f7fafc;
}

.upload-v4-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7fafc;
}

/* ========== 自定义状态栏 ========== */
.upload-v4-top-sticky {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
}

.upload-v4-statusbar {
  background: #ffffff;
  flex-shrink: 0;
}

/* ========== 自定义导航栏 ========== */
.upload-v4-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx 20rpx 20rpx;
  background: #ffffff;
  box-sizing: border-box;
  gap: 12rpx;
}

.upload-v4-nav__back {
  width: 64rpx;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.upload-v4-nav__back-icon {
  font-size: 48rpx;
  font-weight: 300;
  color: #2d3748;
  line-height: 1;
}

.upload-v4-nav__title {
  flex: 1;
  min-width: 0;
  font-size: 36rpx;
  font-weight: 800;
  color: #1a202c;
  text-align: left;
}

.upload-v4-nav__capsule {
  width: 152rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: none;
  background: transparent;
  box-shadow: none;
  flex-shrink: 0;
}

/* ========== 可滚动主区域 ========== */
.upload-v4-scroll {
  flex: 1;
  min-height: 0;
}

.upload-v4-top-placeholder {
  width: 100%;
  flex-shrink: 0;
}

.upload-v4-scroll-inner {
  padding: 20rpx 28rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ========== 步骤条 ========== */
.step-strip {
  display: flex;
  gap: 12rpx;
}

.step-item {
  flex: 1;
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: rgba(22, 111, 247, 0.06);
  color: #a0aec0;
  font-size: 24rpx;
  font-weight: 700;
}

.step-item--done {
  background: rgba(53, 173, 116, 0.1);
  color: #259160;
}

.step-item--active {
  background: rgba(22, 111, 247, 0.12);
  color: #166ff7;
}

/* ========== 当前训练动作核对 ========== */
.upload-action-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, #effaf7 0%, #e3f6ef 100%);
  border: 1rpx solid #b9e3d4;
  box-shadow: 0 12rpx 28rpx rgba(36, 107, 80, 0.08);
}

.upload-action-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.upload-action-card__eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  color: #299665;
}

.upload-action-card__name {
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #22543d;
}

.upload-action-card__change {
  min-height: 56rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #ffffff;
  color: #267c59;
  border: 1rpx solid rgba(53, 173, 116, 0.28);
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.upload-action-card__tip {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(53, 173, 116, 0.18);
  color: #3f6b5a;
  font-size: 25rpx;
  line-height: 1.7;
}

/* ========== 上传引导 hero ========== */
.upload-hero-card {
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(34, 87, 139, 0.08);
  border: 1rpx solid rgba(121, 175, 219, 0.16);
}

.upload-hero-card__title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
}

.upload-hero-card__desc {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.6;
  color: #718096;
}

/* ========== info-panel 通用面板 ========== */
.info-panel {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(34, 87, 139, 0.08);
  border: 1rpx solid rgba(121, 175, 219, 0.16);
}

.info-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
  margin-bottom: 20rpx;
}

/* ========== 视频预览区 ========== */
.video-preview-zone {
  height: 280rpx;
  border-radius: 24rpx;
  background: #1a202c;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.video-preview-zone__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.video-preview-zone__icon {
  font-size: 56rpx;
}

.video-preview-zone__meta {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.video-preview-thumb {
  margin-top: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid rgba(121, 175, 219, 0.18);
}

.video-preview-thumb__video {
  width: 100%;
  height: 320rpx;
  display: block;
  background: #0f172a;
}

/* ========== 视频可提交状态 ========== */
.upload-ready-panel {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #b9e3d4;
  border-radius: 28rpx;
  background: #effaf7;
}

.upload-ready-panel__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #35ad74;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.upload-ready-panel__title {
  color: #246b50;
  font-size: 30rpx;
  font-weight: 800;
}

.upload-ready-panel__desc {
  margin-top: 6rpx;
  color: #557d73;
  font-size: 25rpx;
  line-height: 1.55;
}

/* ========== 问题提醒(橙色面板) ========== */
.warn-panel {
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 189, 102, 0.12);
  border: 2rpx solid rgba(221, 107, 32, 0.2);
}

.warn-panel__title {
  font-size: 32rpx;
  font-weight: 800;
  color: #dd6b20;
  margin-bottom: 16rpx;
}

.warn-panel__message {
  margin-bottom: 10rpx;
  color: #9c4221;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.6;
}

.warn-panel__item {
  font-size: 28rpx;
  line-height: 1.7;
  color: #4a5568;
}

/* ========== 底部操作栏占位 ========== */
.dock-spacer {
  height: 280rpx;
}

/* ========== 底部固定操作栏 ========== */
.action-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 32rpx rgba(34, 87, 139, 0.1);
  border-top: 1rpx solid rgba(121, 175, 219, 0.14);
  backdrop-filter: blur(20rpx);
  z-index: 100;
}

.action-dock__gap {
  height: 16rpx;
}

/* ========== 按钮样式 ========== */
.action-dock .btn-big {
  display: flex !important;
  width: 100% !important;
  min-width: 100% !important;
  margin: 0 !important;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0 28rpx;
  box-sizing: border-box;
  border: none;
  line-height: 1;
}

.btn-big::after {
  border: none;
}

.btn-teal {
  background: linear-gradient(135deg, #38b2ac 0%, #2c7a7b 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(44, 122, 123, 0.28);
}

.btn-teal[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.btn-ghost {
  background: rgba(255, 255, 255, 0.9);
  color: #4a5568;
  border: 2rpx solid rgba(121, 175, 219, 0.24);
  box-shadow: 0 8rpx 20rpx rgba(34, 87, 139, 0.06);
}

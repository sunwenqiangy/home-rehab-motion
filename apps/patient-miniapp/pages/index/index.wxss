page {
  background: #f7fafc;
  color: #2d3748;
}

.home-v4-page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7fafc;
}

.home-v4-top-sticky {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #ffffff;
}

.home-v4-statusbar {
  background: #ffffff;
}

.home-v4-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 36rpx;
  padding-right: 24rpx;
  padding-top: 16rpx;
  padding-bottom: 20rpx;
  background: #ffffff;
  box-sizing: border-box;
  gap: 12rpx;
}

.home-v4-nav__title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1a202c;
}

.home-v4-guest-login-button::after {
  border: 0;
}

.home-v4-nav__capsule {
  width: 152rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: none;
  background: transparent;
  box-shadow: none;
  flex-shrink: 0;
}

.home-v4-screen {
  flex: 1;
  box-sizing: border-box;
}

.home-v4-top-placeholder {
  width: 100%;
  flex-shrink: 0;
}

.home-v4-screen-inner {
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 150rpx);
  box-sizing: border-box;
}

.v4-card,
.v4-weekly-panel,
.v4-info-panel {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 24rpx rgba(14, 154, 167, 0.08);
  margin-bottom: 28rpx;
}

.v4-hero-card {
  position: relative;
  overflow: hidden;
  border-radius: 40rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 28rpx;
  background: linear-gradient(135deg, #0e9aa7 0%, #3ec6d0 100%);
  color: #ffffff;
}

.v4-hero-card::after {
  content: '';
  position: absolute;
  right: -44rpx;
  top: -36rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.v4-hero-badge,
.v4-hero-title,
.v4-hero-sub,
.v4-btn-big {
  position: relative;
  z-index: 1;
}

.v4-hero-badge {
  display: inline-block;
  min-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.v4-hero-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
}

.v4-hero-sub {
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.6;
  opacity: 0.9;
}

.v4-btn-big {
  margin-top: 28rpx;
  width: 100%;
  min-height: 88rpx;
  border: none;
  border-radius: 28rpx;
  font-size: 34rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.v4-btn-big::after {
  border: none;
}

.v4-btn-white {
  background: #ffffff;
  color: #0e9aa7;
  box-shadow: 0 8rpx 32rpx rgba(14, 154, 167, 0.22);
}

.v4-feedback-card {
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  background: #ebf8ff;
  border: 1rpx solid #bee3f8;
}

.v4-feedback-card:active {
  opacity: 0.9;
}

.v4-feedback-icon {
  font-size: 40rpx;
  line-height: 1;
}

.v4-feedback-main {
  flex: 1;
  min-width: 0;
}

.v4-feedback-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3182ce;
}

.v4-feedback-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #718096;
}

.v4-card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
}

.v4-card-desc {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #718096;
  line-height: 1.7;
}

.v4-action-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.v4-action-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(14, 154, 167, 0.08);
}

.v4-action-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}

.v4-action-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1a202c;
}

.v4-action-chip-wrap {
  margin-top: 12rpx;
}

.v4-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.v4-chip-sm {
  min-height: 38rpx;
  font-size: 22rpx;
  padding: 0 14rpx;
}

.v4-chip-teal {
  background: #e6f7f8;
  color: #0e9aa7;
}

.v4-chip-green {
  background: #f0fff4;
  color: #38a169;
}

.v4-chip-orange {
  background: #fffaf0;
  color: #dd6b20;
}

.v4-chip-coral {
  background: #fff1f0;
  color: #f56565;
}

.v4-chip-blue {
  background: #ebf8ff;
  color: #3182ce;
}

.v4-weekly-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.v4-weekly-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
}

.v4-weekly-sub {
  font-size: 26rpx;
  color: #718096;
  line-height: 1.6;
}

.v4-progress-bar {
  margin-top: 14rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.v4-progress-fill {
  height: 100%;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #0e9aa7, #3ec6d0);
  transition: width 0.6s;
}

.v4-weekly-days {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
}

.v4-day-pill {
  text-align: center;
  padding: 14rpx 0;
  border-radius: 18rpx;
  background: #edf2f7;
  color: #718096;
  font-size: 22rpx;
  font-weight: 700;
}

.v4-day-pill-done {
background: #e6f7f8;
color: #0e9aa7;
}

.v4-day-pill-done.v4-day-pill-today {
background: #d8f5ec;
color: #087f6b;
box-shadow: inset 0 0 0 2rpx #2fbe9d;
}


.v4-day-pill-today {
  background: #fffaf0;
  color: #dd6b20;
}

.v4-stage-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.v4-info-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a202c;
}

.v4-stage-grid {
  margin-top: 14rpx;
  display: grid;
  gap: 10rpx;
}

.v4-stage-card {
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e2e8f0;
  background: #ffffff;
}

.v4-stage-card-active {
  border-color: rgba(56, 161, 105, 0.3);
  background: #f0fff4;
}

.v4-stage-card-waiting {
  opacity: 0.65;
}

.v4-stage-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1a202c;
}

.v4-stage-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #718096;
  line-height: 1.6;
}

.v4-list-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.v4-list-row:last-child {
  border-bottom: none;
}

.v4-list-row:active {
  opacity: 0.86;
}

.v4-status-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.v4-dot-green {
  background: #38a169;
}

.v4-dot-teal {
  background: #0e9aa7;
}

.v4-dot-orange {
  background: #dd6b20;
}

.v4-dot-red {
  background: #f56565;
}

.v4-list-body {
  flex: 1;
  min-width: 0;
}

.v4-list-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a202c;
}

.v4-list-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #718096;
  line-height: 1.4;
}

.v4-list-badge {
  font-size: 28rpx;
  font-weight: 800;
}

.v4-list-badge-green {
  color: #38a169;
}

.v4-list-badge-teal {
  color: #0e9aa7;
}

.v4-list-badge-orange {
  color: #dd6b20;
}

.home-v4-guest-login-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 124rpx);
  z-index: 12;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 20rpx 18rpx 28rpx;
  border-radius: 24rpx;
  color: #24525a;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12rpx 36rpx rgba(14, 154, 167, 0.18);
}

.home-v4-guest-login-copy {
  flex: 1;
  min-width: 0;
}

.home-v4-guest-login-title {
  color: #1a202c;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.35;
}

.home-v4-guest-login-text {
  margin-top: 4rpx;
  color: #58747a;
  font-size: 22rpx;
  line-height: 1.45;
}

.home-v4-guest-login-button {
  min-width: 120rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: #0e9aa7;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
}

.home-v4-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 12rpx 0 calc(env(safe-area-inset-bottom) + 4rpx);
  border-top: 1rpx solid #e2e8f0;
  background: #ffffff;
  z-index: 10;
}

.home-v4-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #718096;
  text-decoration: none;
}

.home-v4-tab-active {
  color: #0e9aa7;
}

.home-v4-tab__icon {
  font-size: 40rpx;
  line-height: 1;
}

.home-v4-tab__label {
  font-size: 22rpx;
  line-height: 1.2;
}

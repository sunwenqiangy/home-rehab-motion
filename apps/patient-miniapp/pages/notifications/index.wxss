/* ========== P09 消息中心 — V4 高保真 ========== */

.v4-page {
  min-height: 100vh;
  background: #f7fafc;
  display: flex;
  flex-direction: column;
}

.v4-top-sticky {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
}

.v4-statusbar {
  background: #fff;
  flex-shrink: 0;
}

.v4-navbar {
  display: flex;
  align-items: center;
  min-height: 108rpx;
  padding: 16rpx 24rpx 20rpx 20rpx;
  background: #fff;
  box-sizing: border-box;
  gap: 12rpx;
}
.v4-navbar-left {
  width: 64rpx;
  height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.v4-navbar-back {
  font-size: 48rpx;
  color: #2d3748;
  font-weight: 300;
  line-height: 1;
}
.v4-navbar-title {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 800;
  color: #1a202c;
  text-align: left;
}
.v4-navbar-capsule {
  width: 152rpx;
  height: 60rpx;
  border-radius: 999rpx;
  border: none;
  background: transparent;
  box-shadow: none;
  flex-shrink: 0;
}

.v4-screen {
  flex: 1;
  padding: 0 32rpx 80rpx;
  background: #f7fafc;
}

.v4-top-placeholder {
  width: 100%;
  flex-shrink: 0;
}

/* 类型 Chips */
.v4-type-chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 24rpx 0 16rpx;
}

/* Chip */
.v4-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.v4-chip--teal { background: #e6f7f8; color: #0e9aa7; }
.v4-chip--gray { background: #edf2f7; color: #718096; }
.v4-chip--orange { background: #fffaf0; color: #dd6b20; }
.v4-chip--green { background: #f0fff4; color: #38a169; }
.v4-chip--coral { background: #fff1f0; color: #f56565; }
.v4-type-chips .v4-chip--active {
  box-shadow: inset 0 0 0 2rpx currentColor;
  transform: translateY(-2rpx);
}
.v4-chip--sm { padding: 8rpx 24rpx; font-size: 24rpx; }

/* 卡片 */
.v4-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(14,154,167,0.08);
}

/* 列表行 */
.v4-list-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}
.v4-list-row:last-child {
  border-bottom: none;
}
.v4-list-row--read {
  opacity: 0.6;
}

/* 状态圆点 */
.v4-status-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 24rpx;
}
.v4-status-dot--green { background: #38a169; }
.v4-status-dot--orange { background: #dd6b20; }
.v4-status-dot--teal { background: #0e9aa7; }
.v4-status-dot--gray { background: #cbd5e0; }

/* 列表主体 */
.v4-list-body {
  flex: 1;
  min-width: 0;
}
.v4-list-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.v4-list-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a202c;
}
.v4-list-sub {
  font-size: 26rpx;
  color: #718096;
  margin-top: 8rpx;
  line-height: 1.6;
}
.v4-list-time {
  font-size: 24rpx;
  color: #cbd5e0;
  margin-top: 8rpx;
}

/* 小圆点 */
.v4-notice-dot-sm {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #f56565;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
  padding: 0 6rpx;
}

/* 空态 */
.v4-empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}
.v4-empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}
.v4-empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2d3748;
}
.v4-empty-desc {
  font-size: 28rpx;
  color: #718096;
  margin-top: 12rpx;
  line-height: 1.6;
}

page { background: #f4fbfa; }
.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  color: #173b3c;
  background: linear-gradient(180deg, #f4fbfa 0%, #eaf7f4 48%, #f8fcfb 100%);
}
.login-header { padding-left: 32rpx; padding-right: 210rpx; }
.login-back { display: inline-flex; align-items: center; min-height: 88rpx; padding: 0 12rpx; color: #315c5b; font-size: 28rpx; }
.login-back__arrow { margin-right: 10rpx; font-size: 50rpx; line-height: 1; }
.login-content { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 28rpx 48rpx 208rpx; text-align: center; }
.login-emblem { position: relative; width: 180rpx; height: 180rpx; margin: 0 auto 36rpx; }
.login-emblem__circle { position: absolute; inset: 0; border: 3rpx solid #a6dcd4; border-radius: 50%; background: #dff2ed; }
.login-emblem__line { position: absolute; left: 35rpx; width: 108rpx; height: 48rpx; border: 5rpx solid #42a99d; border-left: 0; border-right: 0; border-bottom: 0; border-radius: 50%; transform: rotate(-18deg); }
.login-emblem__line--one { top: 73rpx; }
.login-emblem__line--two { top: 98rpx; opacity: .55; }
.login-emblem__dot { position: absolute; top: 48rpx; left: 82rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #168f83; }
.login-eyebrow { color: #397d75; font-size: 26rpx; font-weight: 600; letter-spacing: 2rpx; }
.login-title { margin-top: 18rpx; color: #173b3c; font-size: 48rpx; line-height: 1.35; font-weight: 700; }
.login-subtitle { margin-top: 18rpx; color: #4d6d69; font-size: 30rpx; line-height: 1.65; }
.login-info { margin-top: 46rpx; padding: 30rpx 32rpx; border: 2rpx solid #cce8e1; border-radius: 24rpx; background: rgba(255,255,255,.8); text-align: left; }
.login-info__title { color: #244d49; font-size: 30rpx; line-height: 1.5; font-weight: 700; }
.login-info__desc { margin-top: 10rpx; color: #4d6d69; font-size: 27rpx; line-height: 1.7; }
.login-actions { padding: 0 44rpx calc(env(safe-area-inset-bottom) + 32rpx); }
.login-actions .login-button { width: 100%; min-height: 104rpx; display: flex; align-items: center; justify-content: center; margin: 0; border-radius: 24rpx; color: #fff; background: linear-gradient(135deg, #3bb8ae 0%, #2b958d 100%); font-size: 34rpx; font-weight: 700; box-shadow: 0 12rpx 26rpx rgba(43,149,141,.2); }
.login-button::after { border: none; }
.login-button:active { background: #25867f; }
.login-agreement { display: flex; align-items: center; justify-content: center; min-height: 76rpx; padding: 4rpx 0; color: #496b67; font-size: 26rpx; line-height: 1.5; }
.login-check { flex: none; width: 36rpx; height: 36rpx; box-sizing: border-box; display: flex; align-items: center; justify-content: center; margin-right: 12rpx; border: 2rpx solid #769c96; border-radius: 8rpx; color: #fff; font-size: 25rpx; font-weight: 700; }
.login-check--selected { border-color: #2b958d; background: #2b958d; }
.login-agreement__link { color: #06796f; font-weight: 700; }

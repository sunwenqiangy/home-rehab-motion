page {
  background: #f7fafc;
  color: #2d3748;
}

.submit-page {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: #f7fafc;
  color: #2d3748;
  overflow: hidden;
}

.submit-header {
  flex-shrink: 0;
  padding-bottom: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0e9aa7 0%, #3ec6d0 100%);
  box-shadow: 0 8rpx 24rpx rgba(14, 154, 167, 0.16);
}

.submit-statusbar { height: 0; }

.submit-navbar {
  height: 92rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.submit-navbar__back,
.submit-navbar__placeholder {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-navbar__back {
  font-size: 52rpx;
  font-weight: 300;
}

.submit-navbar__title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
}

.submit-header__copy {
  padding: 10rpx 32rpx 0;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
}

.submit-scroll {
  height: 0;
  flex: 1;
}

.submit-content {
  padding: 28rpx 32rpx calc(176rpx + env(safe-area-inset-bottom));
}

.submit-context {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid rgba(14, 154, 167, 0.14);
  border-radius: 24rpx;
  background: #edf9fa;
}

.submit-context__icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0e9aa7;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.submit-context__label { color: #679397; font-size: 21rpx; }
.submit-context__title { margin-top: 4rpx; color: #17666d; font-size: 28rpx; font-weight: 800; }

.submit-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(14, 154, 167, 0.08);
}

.submit-label { color: #253858; font-size: 28rpx; font-weight: 800; }
.submit-label--content { margin-top: 30rpx; }
.submit-label text { color: #8da1a6; font-size: 22rpx; font-weight: 400; }

.submit-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #edf9fa;
  color: #286e75;
  font-size: 27rpx;
}

.submit-picker__arrow { color: #6eb8bf; font-size: 38rpx; }

.submit-safety-note {
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #f4d2ad;
  border-radius: 18rpx;
  background: #fff9ef;
}

.submit-safety-note__title { color: #bf6a2c; font-size: 26rpx; font-weight: 800; }
.submit-safety-note__desc { margin-top: 8rpx; color: #8a6732; font-size: 22rpx; line-height: 1.65; }

.submit-input {
  width: 100%;
  min-height: 190rpx;
  margin-top: 14rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: #f8fcfc;
  color: #26364a;
  font-size: 27rpx;
  line-height: 1.65;
}

.submit-counter { margin-top: 8rpx; color: #9aabae; text-align: right; font-size: 20rpx; }
.submit-images { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 14rpx; }
.submit-image-wrap { position: relative; }
.submit-image { width: 128rpx; height: 128rpx; border-radius: 16rpx; }
.submit-image-remove { position: absolute; top: -10rpx; right: -10rpx; width: 32rpx; height: 32rpx; border-radius: 50%; background: #ef6a60; color: #ffffff; text-align: center; line-height: 31rpx; }

.submit-image-add {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: 1rpx dashed #85cdd3;
  border-radius: 16rpx;
  color: #0e9aa7;
  font-size: 20rpx;
}

.submit-image-add__plus { font-size: 40rpx; line-height: 1; }
.submit-note { margin: 22rpx 8rpx; color: #718096; font-size: 22rpx; line-height: 1.65; }

.submit-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  box-sizing: border-box;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(14, 154, 167, 0.12);
  background: #ffffff;
  box-shadow: 0 -8rpx 24rpx rgba(14, 154, 167, 0.1);
}

.submit-button {
  display: block;
  width: 100%;
  height: 88rpx;
  margin: 0 auto;
  padding: 0;
  border-radius: 22rpx;
  background: #0e9aa7;
  box-shadow: 0 12rpx 24rpx rgba(14, 154, 167, 0.22);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.submit-button::after { border: 0; }

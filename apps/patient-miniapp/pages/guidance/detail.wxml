<view class="detail-page">
  <view class="detail-top-sticky"><view class="detail-statusbar" style="height: {{statusBarHeight}}px;"></view><view class="detail-nav" style="height: {{navBarHeight}}px;"><view class="detail-nav__back" bindtap="onGoBack"><text class="detail-nav__back-icon">‹</text></view><text class="detail-nav__title">动作指导</text><view class="detail-nav__capsule"></view></view></view>
  <view wx:if="{{loading}}" class="detail-loading"><view class="detail-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view><view class="detail-loading__text">正在加载指导内容...</view></view>
  <view wx:elif="{{failed}}" class="detail-empty"><view class="detail-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view><text>当前动作指导暂未准备好</text><button bindtap="onGoBack">返回训练列表</button></view>
  <scroll-view wx:else class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="detail-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view><view class="detail-scroll-inner">
    <view class="detail-overview"><image wx:if="{{detail.coverUrl}}" class="detail-overview__cover" src="{{detail.coverUrl}}" mode="aspectFill" bindtap="onPreviewImage" data-url="{{detail.coverUrl}}"/><view><view class="detail-overview__title">{{detail.title}}</view><view class="detail-overview__brief">{{detail.briefInstruction}}</view><view class="detail-overview__time">建议用时：约 {{detail.estimatedMinutes}} 分钟</view></view></view>
    <view class="detail-video-zone"><video wx:if="{{detail.videoUrl && !videoFailed}}" class="detail-video" src="{{detail.videoUrl}}" controls show-fullscreen-btn binderror="onVideoError"></video><view wx:else class="detail-video-fallback"><text class="detail-video-zone__icon">▶</text><text>{{detail.videoFallbackText}}</text></view></view>
    <view class="info-panel safety-panel"><view class="info-title">开始前请确认</view><view class="panel-text">{{detail.trainingSafetyNotice}}</view></view>
    <view class="info-panel steps-panel"><view class="info-title">动作步骤</view><view class="steps-panel__intro">请按顺序慢慢完成。</view><view wx:for="{{detail.steps}}" wx:key="id" class="step-card"><view class="step-card__heading"><text class="step-card__label">步骤 {{item.number}}</text><view class="step-card__title">{{item.title}}</view></view><view wx:if="{{item.description}}" class="step-card__desc">{{item.description}}</view><image wx:if="{{item.imageUrl}}" class="step-card__image" src="{{item.imageUrl}}" mode="aspectFill" bindtap="onPreviewImage" data-url="{{item.imageUrl}}"/><view wx:if="{{item.altText}}" class="step-card__alt">图片说明：{{item.altText}}</view></view></view>
    <view class="info-panel shooting-panel"><view class="shooting-panel__heading"><view><view class="info-title">拍摄要求</view><view class="shooting-panel__intro">录制前请按下面三步准备，画面越清晰，动作识别越准确。</view></view><view class="shooting-panel__badge">照着拍</view></view><view wx:for="{{detail.shootingRequirements}}" wx:key="type" class="shooting-card"><view class="shooting-card__top"><view class="shooting-card__number">{{item.order}}</view><view><view class="shooting-card__type">{{item.typeLabel}}</view><view class="shooting-card__title">{{item.title}}</view></view><view class="shooting-card__pass">建议</view></view><image class="shooting-card__image" src="{{item.correctUrl}}" mode="aspectFill" bindtap="onPreviewImage" data-url="{{item.correctUrl}}"/><view class="shooting-card__desc">{{item.description}}</view><view class="shooting-card__alt">示意图说明：{{item.altText}}</view></view></view>
    <view wx:if="{{detail.hasCommonMistakes}}" class="info-panel"><view class="info-title">常见错误</view><view wx:for="{{detail.commonMistakes}}" wx:key="id" class="mistake-card"><image wx:if="{{item.media.url}}" class="mistake-card__image" src="{{item.media.url}}" mode="aspectFill" bindtap="onPreviewImage" data-url="{{item.media.url}}"/><view class="mistake-card__title">× {{item.title}}</view><view class="mistake-card__desc">{{item.mistakeDescription}}</view><view class="mistake-card__correct">✓ {{item.correction}}</view></view></view>
    <view class="dock-spacer"></view>
  </view></scroll-view>
  <view class="action-dock" wx:if="{{!loading && !failed}}"><button class="btn-big btn-teal" bindtap="onStartUpload">立即录制训练视频</button><view class="action-dock__gap"></view><button class="btn-big btn-outline" bindtap="onChooseFromAlbum">从相册选择视频</button></view>
</view>

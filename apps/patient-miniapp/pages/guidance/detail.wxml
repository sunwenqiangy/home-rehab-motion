<view class="detail-page">
  <view class="detail-top-sticky"><view class="detail-statusbar" style="height: {{statusBarHeight}}px;"></view><view class="detail-nav" style="height: {{navBarHeight}}px;"><view class="detail-nav__back" bindtap="onGoBack"><image class="detail-nav__back-icon" src="../../assets/icons/common/arrow-left.svg" mode="aspectFit"/></view><text class="detail-nav__title">动作指导</text><view class="detail-nav__capsule"></view></view></view>
  <view wx:if="{{loading}}" class="detail-loading"><view class="detail-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view><view class="detail-loading__text">正在加载指导内容...</view></view>
  <view wx:elif="{{failed}}" class="detail-empty"><view class="detail-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view><view class="detail-empty__card"><text class="detail-empty__icon">{{errorIcon}}</text><text class="detail-empty__title">{{errorTitle}}</text><text class="detail-empty__desc">{{errorDesc}}</text><button class="detail-empty__retry" bindtap="onRetryLoad">重新加载</button><button class="detail-empty__back" bindtap="onGoBack">返回训练列表</button></view></view>
  <scroll-view wx:else class="detail-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="detail-top-placeholder" style="height: {{topPlaceholderHeight}}px;"></view><view class="detail-scroll-inner">
    <view class="detail-overview"><image wx:if="{{detail.coverUrl}}" class="detail-overview__cover" src="{{detail.coverUrl}}" mode="aspectFit" bindtap="onPreviewImage" data-url="{{detail.coverUrl}}"/><view><view class="detail-overview__title">{{detail.title}}</view><view class="detail-overview__brief">{{detail.briefInstruction}}</view><view wx:if="{{detail.trainingAdvice}}" class="detail-overview__time">训练建议：{{detail.trainingAdvice}}</view></view></view>
    <view class="info-panel practice-panel"><view class="info-title">先练习，再回看动作</view><view class="panel-text">按上方训练建议完成练习。练习时或练习后，拍摄一小段完整动作即可，无需录下全部练习。</view><view class="practice-panel__hint">{{detail.clipLimitHint}}</view></view>
    <view class="info-panel safety-panel"><view class="info-title">开始前请确认</view><view class="panel-text">{{detail.trainingSafetyNotice}}</view></view>
    <view class="detail-video-zone"><video wx:if="{{detail.videoUrl && !videoFailed}}" class="detail-video" src="{{detail.videoUrl}}" controls show-fullscreen-btn binderror="onVideoError"></video><view wx:else class="detail-video-fallback"><text class="detail-video-zone__icon">▶</text><text>{{detail.videoFallbackText}}</text></view></view>
    <view class="info-panel steps-panel"><view class="info-title">动作步骤</view><view class="steps-panel__intro">请按顺序慢慢完成。</view><view wx:for="{{detail.steps}}" wx:key="id" class="step-card"><view class="step-card__heading"><text class="step-card__label">步骤 {{item.number}}</text><view class="step-card__title">{{item.title}}</view></view><view wx:if="{{item.description}}" class="step-card__desc">{{item.description}}</view><image wx:if="{{item.imageUrl}}" class="step-card__image" src="{{item.imageUrl}}" mode="aspectFit" bindtap="onPreviewImage" data-url="{{item.imageUrl}}"/><view wx:if="{{item.altText}}" class="step-card__alt">图片说明：{{item.altText}}</view></view></view>
    <view class="info-panel shooting-panel"><view class="shooting-panel__heading"><view><view class="info-title">拍摄要求</view><view class="shooting-panel__intro">{{detail.clipHint}}录制前请按下面三步准备，画面清晰有助于识别动作。</view></view><view class="shooting-panel__badge">照着拍</view></view><view wx:for="{{detail.shootingRequirements}}" wx:key="id" class="shooting-card"><view class="shooting-card__top"><view class="shooting-card__number">{{item.order}}</view><view><view class="shooting-card__type">{{item.typeLabel}}</view><view class="shooting-card__title">{{item.title}}</view></view><view class="shooting-card__pass">建议</view></view><image wx:if="{{item.correctUrl}}" class="shooting-card__image" src="{{item.correctUrl}}" mode="aspectFit" bindtap="onPreviewImage" data-url="{{item.correctUrl}}"/><view class="shooting-card__desc">{{item.description}}</view><view class="shooting-card__alt">示意图说明：{{item.altText}}</view></view></view>
    <view wx:if="{{detail.hasCommonMistakes}}" class="info-panel"><view class="info-title">常见错误</view><view wx:for="{{detail.commonMistakes}}" wx:key="id" class="mistake-card"><video wx:if="{{item.isVideo && item.media.url}}" class="mistake-card__image" src="{{item.media.url}}" controls show-fullscreen-btn></video><image wx:elif="{{item.media.url}}" class="mistake-card__image" src="{{item.media.url}}" mode="aspectFit" bindtap="onPreviewImage" data-url="{{item.media.url}}"/><view class="mistake-card__title">× {{item.title}}</view><view class="mistake-card__desc">{{item.mistakeDescription}}</view><view class="mistake-card__correct">✓ {{item.correction}}</view></view></view>
    <view class="dock-spacer"></view>
  </view></scroll-view>
  <view class="action-dock" wx:if="{{!loading && !failed}}"><button class="btn-big btn-ghost" bindtap="onStartUpload">拍摄训练视频</button><view class="action-dock__gap"></view><button class="btn-big btn-teal" bindtap="onChooseFromAlbum">从相册选择</button></view>
</view>

# =============================
# Home Rehab Motion 环境变量模板
# 复制为 .env 后按本机环境修改
# =============================

# --- main-service 基础配置（本文件仅用于本地开发，禁止直接作为生产环境配置） ---
NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://root@127.0.0.1:3306/home_rehab_motion
REDIS_URL=redis://127.0.0.1:6379/0
PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api

# --- 对象存储（本地 MinIO / 线上 OSS）---
OSS_ENDPOINT=http://127.0.0.1:9000
OSS_BUCKET=home-rehab-motion-assets
# local_proxy: 由 main-service 接收文件再落盘；s3_post: 前端直传 OSS/MinIO
STORAGE_UPLOAD_MODE=local_proxy
# 兼容 main-service / analysis-service 两种命名
OSS_ACCESS_KEY=minioadmin
OSS_SECRET_KEY=minioadmin
OSS_ACCESS_KEY_ID=minioadmin
OSS_ACCESS_KEY_SECRET=minioadmin
OSS_REGION=cn-beijing
# MinIO 常见需要 path style，默认 true
OSS_FORCE_PATH_STYLE=true
# 预签名有效期（秒）
OSS_PRESIGNED_EXPIRES_SECONDS=900
# 直传模式下是否跳过服务端对象存在性检查（开发环境可 true 跳过，生产建议 false 开启严格校验）
STORAGE_SKIP_DIRECT_OBJECT_CHECK=true
# 直传对象存在性检查的 HTTP 超时（毫秒）
STORAGE_OBJECT_CHECK_TIMEOUT_MS=4000
# 直传对象存在性检查的预签名 URL 有效期（秒，需小于 OSS_PRESIGNED_EXPIRES_SECONDS）
STORAGE_OBJECT_CHECK_EXPIRES_SECONDS=120
# OSS 公共访问基址（s3_post 直传后用于拼接素材的可访问 URL，未配置则回退 /oss-assets/ 代理）
OSS_PUBLIC_BASE_URL=http://127.0.0.1:9000/home-rehab-motion-assets

# --- 鉴权与登录 ---
# 生产必须通过密钥管理服务注入，至少 32 位且不可使用默认值。
AUTH_TOKEN_SECRET=replace-with-your-secret
AUTH_TOKEN_TTL_SECONDS=604800
WX_APP_ID=wx86112af48eb6319b
WX_APP_SECRET=6a469dd1e92219b10cb5d7db8f0a91ae
AUTH_ALLOW_LEGACY_MOCK_TOKEN=false
# 本地联调建议 true，可绕过真实微信 jscode2session
MOCK_AUTH_FALLBACK=true

# --- 分析链路（main-service -> analysis-service）---
ANALYSIS_PORT=8001
ANALYSIS_SERVICE_URL=http://127.0.0.1:8001
ANALYSIS_CALLBACK_URL=http://127.0.0.1:3000/api/videos/internal/analysis-callback
# 生产必须通过密钥管理服务注入，至少 32 位且不可使用默认值。
ANALYSIS_INTERNAL_TOKEN=home-rehab-motion-internal-token
ANALYSIS_ALLOW_COMPAT_FALLBACK=false

# --- analysis-service 运行参数 ---
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
ANALYSIS_DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/home_rehab_motion
LOCAL_STORAGE_ROOT=/absolute/path/to/home_rehab_motion/.local-storage
SAMPLE_FPS=10
MODEL_COMPLEXITY=1
ANALYSIS_TIMEOUT_SECONDS=600
ALLOW_SAMPLE_VIDEO_FALLBACK=false
ALLOW_MOCK_KEYPOINTS_FALLBACK=false

# --- 初始管理员（只用于执行 npm run bootstrap:admin -w @home-rehab-motion/main-service） ---
# 引导命令仅允许数据库中不存在任何管理员账号时执行；生产使用临时密钥注入并在完成后立即删除。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
